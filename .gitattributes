# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# RC files
.* text eol=lf

# Configs
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Graphics
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.svg text eol=lf

# Special files
package.json text eol=lf
package-lock.json text eol=lf
tsconfig.json text eol=lf
